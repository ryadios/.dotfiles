#!/usr/bin/env bash

sink=@DEFAULT_AUDIO_SINK@
step=5%

notify() {
    if command -v notify-send >/dev/null 2>&1; then
        notify-send -a Volume "$@"
    else
        echo "$@"
    fi
}

command -v wpctl >/dev/null 2>&1 || {
    notify "wpctl is not available"
    exit 1
}

is_muted() {
    wpctl get-volume "$sink" | grep -q MUTED
}

volume_percent() {
    wpctl get-volume "$sink" | awk '/Volume:/ { printf "%d", $2 * 100 }'
}

send_notification() {
    if is_muted; then
        notify "Muted"
        return
    fi

    local volume
    volume=$(volume_percent)
    notify \
        --hint=string:x-dunst-stack-tag:volume \
        --hint=string:synchronous:volume \
        -u low -h int:value:"$volume" "Volume: ${volume}%" -t 1000
}

case "$1" in
    up|down)
        is_muted && wpctl set-mute "$sink" 0
        if [[ "$1" == up ]]; then
            wpctl set-volume "$sink" "${step}+" --limit 1.0
        else
            wpctl set-volume "$sink" "${step}-"
        fi
        send_notification
        ;;
    mute)
        wpctl set-mute "$sink" toggle
        send_notification
        ;;
    *)
        exit 2
        ;;
esac
