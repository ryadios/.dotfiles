#!/usr/bin/env bash

status=$(< /sys/class/power_supply/BAT1/status)
level=$(< /sys/class/power_supply/BAT1/capacity)

case "$status" in
    Charging)
        printf " "
        ;;
    Discharging|Full|"Not charging")
        if (( level <= 0 )); then
            printf " "
        elif (( level <= 25 )); then
            printf " "
        elif (( level <= 50 )); then
            printf " "
        elif (( level <= 75 )); then
            printf " "
        else
            printf " "
        fi
        ;;
esac
